# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Allowed Telegram User IDs (comma-separated)
# Get your user ID from @userinfobot on Telegram
ALLOWED_USER_IDS=123456789,987654321

# Bot Mode Configuration
# WEBHOOK_MODE: Set to "true" for webhook mode (Cloud Run), "false" for polling mode (local dev)
# Note: When WEBHOOK_MODE=false, API authentication is disabled for easier local testing
WEBHOOK_MODE=false
# WEBHOOK_URL: Required only if WEBHOOK_MODE=true (your Cloud Run service URL)
WEBHOOK_URL=

# HTTP Server Configuration
# PORT: Port for the main HTTP server (serves health checks, webhook, and Mini App at /web-app)
# Automatically set by Cloud Run, default is 8080
PORT=8080

# Notification Configuration
# NOTIFICATION_CHAT_ID: Telegram chat ID to send notifications when events are created via web-app
# Leave empty or 0 to disable notifications
NOTIFICATION_CHAT_ID=
# NOTIFICATION_THREAD_ID: Thread/topic ID for forum groups (optional)
# Leave empty or 0 to send to general chat (no specific topic)
NOTIFICATION_THREAD_ID=

# Database Configuration
# Set to "true" to use in-memory mock database for testing
USE_MOCK_DB=false

# ClickHouse connection (required if USE_MOCK_DB is false)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_USE_TLS=false

# LLM Configuration (optional - enables /ask command)
# Supports any OpenAI-compatible API (Gemini, OpenAI, Ollama, etc.)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash

# OpenTelemetry (optional - exports traces, metrics and logs over OTLP/HTTP)
# Export is disabled when OTEL_EXPORTER_OTLP_ENDPOINT is empty (or OTEL_SDK_DISABLED=true).
# Fill in the endpoint and API key from your ClickStack / Observability service; never commit real values.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer <your-api-key>
OTEL_SERVICE_NAME=library
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development

# Langfuse LLM tracing for /ask (optional, independent of the OTLP backend above).
# Export is enabled when both keys are set (Langfuse project -> Settings -> API Keys).
# Only /ask observations (agent, generations, tool calls) are sent; Telegram/HTTP/DB spans are not.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development

# Langfuse AI Gateway (optional, OpenAI/Anthropic models only — not Gemini).
# Point the LLM client at the gateway's OpenAI route and use a gateway key + <credential>:<model> ID:
#   LLM_BASE_URL=https://gateway.cloud.langfuse.com/openai/v1
#   LLM_API_KEY=<gateway key>
#   LLM_MODEL=openai-prod:<model>
# The gateway then records each LLM call; the bot skips its own generation spans and forwards
# traceparent + langfuse-* headers so gateway generations land inside the /ask trace.
LLM_LANGFUSE_GATEWAY=false
